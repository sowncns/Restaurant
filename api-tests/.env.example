# API_BASE_URL takes precedence; E2E_API_URL is accepted for compatibility.
API_BASE_URL=http://localhost:5000/api
API_TIMEOUT_SECONDS=10
API_VERIFY_TLS=true

# Reuse provisioned E2E identities. Never put real or production secrets here.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_RECEPTIONIST_USERNAME=
E2E_RECEPTIONIST_PASSWORD=
E2E_WAITER_USERNAME=
E2E_WAITER_PASSWORD=
E2E_KITCHEN_USERNAME=
E2E_KITCHEN_PASSWORD=
E2E_CASHIER_USERNAME=
E2E_CASHIER_PASSWORD=
E2E_MANAGER_USERNAME=
E2E_MANAGER_PASSWORD=
E2E_COMPANY_ADMIN_USERNAME=
E2E_COMPANY_ADMIN_PASSWORD=
E2E_SUPER_ADMIN_USERNAME=
E2E_SUPER_ADMIN_PASSWORD=

# Stable records in a disposable test tenant.
E2E_COMPANY_ID=
E2E_BRANCH_ID=
E2E_RESERVATION_TABLE_ID=
E2E_SALES_TABLE_ID=
E2E_MENU_ITEM_ID=
E2E_INGREDIENT_ID=
E2E_SUPPLIER_ID=

# Destructive tests require both this gate and `pytest -m destructive`.
API_DESTRUCTIVE=0
E2E_CUSTOMER_NAME=API Test Customer
E2E_CUSTOMER_PHONE=0900000001
E2E_RESERVATION_TIME=18:30
